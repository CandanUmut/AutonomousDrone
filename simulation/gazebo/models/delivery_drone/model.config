<?xml version="1.0"?>
<model>
  <name>Delivery Drone</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>AutonomousDrone Project</name>
    <email>team@autonomousdrone.local</email>
