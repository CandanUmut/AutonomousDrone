<?xml version="1.0"?>
<model>
  <name>Landing Pad</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>AutonomousDrone Project</name>
  </author>
  <description>
    Landing pad with ArUco marker ID 0 (DICT_4X4_50) for precision landing.
    The pad is 1.2 m x 1.2 m with a 0.5 m ArUco marker in the centre.
    The marker texture requires the materials/textures directory.
  </description>
</model>
