<?xml version="1.0"?>
<model>
  <name>Solar Charging Station</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>AutonomousDrone Project</name>
  </author>
  <description>
    Solar battery-swap charging station. Includes a solar panel array,
    a battery bay with servo-actuated swap mechanism, and status LEDs.
    The drone lands on the adjacent landing_pad model.
  </description>
</model>
