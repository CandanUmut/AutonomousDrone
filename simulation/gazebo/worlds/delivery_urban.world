<?xml version="1.0" ?>
<!--
  Urban Delivery World for Autonomous Drone Simulation

  Layout (all coordinates in Gazebo ENU metres from origin):
    Origin (0,0):   Home base / swap station
    Building A:     25 m North, 10 m East  — 4-storey residential
    Building B:     40 m East              — 3-storey commercial
    Building C:    -20 m North, 15 m East  — 2-storey house
    Delivery pad 1: 80 m North, 5 m East   — Hospital entrance
    Delivery pad 2: 60 m East, 20 m North  — Pharmacy
    Trees:          Scattered obstacles

  The solar charging station model sits at the origin (home base).
  Landing pad with ArUco marker ID 0 is at the origin.
  Delivery target pads use ArUco marker ID 1 and ID 2.
-->
<sdf version="1.6">
  <world name="delivery_urban">

    <!-- Physics settings — reduce for faster simulation if needed -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.400000</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 1000 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Atmosphere for barometer simulation -->
    <atmosphere type="adiabatic"/>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- Gravity -->
    <gravity>0 0 -9.8066</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- ================================================================
         GROUND PLANE
    ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.3 0.35 0.3 1</ambient>
            <diffuse>0.4 0.45 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         ROAD (simplified flat darker strip)
    ================================================================ -->
    <model name="road_north">
      <static>true</static>
      <pose>0 50 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>8 100 0.01</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="road_east">
      <static>true</static>
      <pose>50 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>100 8 0.01</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BUILDING A — 4-storey residential (25 N, 10 E)
         12 m × 8 m footprint, 14 m tall
    ================================================================ -->
    <model name="building_a">
      <static>true</static>
      <pose>10 25 7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 8 14</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 8 14</size></box></geometry>
          <material>
            <ambient>0.8 0.75 0.65 1</ambient>
            <diffuse>0.9 0.85 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BUILDING B — 3-storey commercial (40 E, 0 N)
         20 m × 15 m footprint, 10 m tall
    ================================================================ -->
    <model name="building_b">
      <static>true</static>
      <pose>40 0 5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 15 10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 15 10</size></box></geometry>
          <material>
            <ambient>0.6 0.65 0.7 1</ambient>
            <diffuse>0.7 0.75 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BUILDING C — 2-storey house (-20 N, 15 E)
         10 m × 10 m footprint, 7 m tall
    ================================================================ -->
    <model name="building_c">
      <static>true</static>
      <pose>15 -20 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 10 7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 10 7</size></box></geometry>
          <material>
            <ambient>0.85 0.7 0.6 1</ambient>
            <diffuse>0.9 0.8 0.7 1</diffuse>
          </material>
        </visual>
        <!-- Roof -->
        <visual name="roof">
          <pose>0 0 4 0 0 0</pose>
          <geometry><box><size>11 11 0.5</size></box></geometry>
          <material><ambient>0.6 0.3 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BUILDING D — hospital / delivery target 1 (5 E, 80 N)
         30 m × 20 m, 6 m tall (single storey large)
    ================================================================ -->
    <model name="building_hospital">
      <static>true</static>
      <pose>5 80 3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 20 6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 20 6</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <!-- Red cross marker on roof -->
        <visual name="cross_h">
          <pose>0 0 3.05 0 0 0</pose>
          <geometry><box><size>10 2 0.1</size></box></geometry>
          <material><ambient>0.9 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <visual name="cross_v">
          <pose>0 0 3.05 0 0 0</pose>
          <geometry><box><size>2 10 0.1</size></box></geometry>
          <material><ambient>0.9 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         TREES (cylindrical trunks + spherical canopies)
    ================================================================ -->
    <model name="tree_1">
      <static>true</static>
      <pose>5 15 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.5 0 0 0</pose>
          <geometry><sphere><radius>2.2</radius></sphere></geometry>
          <material><ambient>0.1 0.45 0.1 1</ambient><diffuse>0.1 0.5 0.1 1</diffuse></material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry>
        </collision>
        <collision name="canopy_collision">
          <pose>0 0 4.5 0 0 0</pose>
          <geometry><sphere><radius>2.2</radius></sphere></geometry>
        </collision>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-8 10 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>4</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 5.5 0 0 0</pose>
          <geometry><sphere><radius>2.5</radius></sphere></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient></material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>4</length></cylinder></geometry>
        </collision>
        <collision name="canopy_collision">
          <pose>0 0 5.5 0 0 0</pose>
          <geometry><sphere><radius>2.5</radius></sphere></geometry>
        </collision>
      </link>
    </model>

    <model name="tree_3">
      <static>true</static>
      <pose>30 35 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.0 0 0 0</pose>
          <geometry><sphere><radius>1.8</radius></sphere></geometry>
          <material><ambient>0.15 0.5 0.1 1</ambient></material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry>
        </collision>
        <collision name="canopy_collision">
          <pose>0 0 4.0 0 0 0</pose>
          <geometry><sphere><radius>1.8</radius></sphere></geometry>
        </collision>
      </link>
    </model>

    <model name="tree_4">
      <static>true</static>
      <pose>-5 45 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 6.5 0 0 0</pose>
          <geometry><sphere><radius>3.0</radius></sphere></geometry>
          <material><ambient>0.1 0.55 0.15 1</ambient></material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>5</length></cylinder></geometry>
        </collision>
        <collision name="canopy_collision">
          <pose>0 0 6.5 0 0 0</pose>
          <geometry><sphere><radius>3.0</radius></sphere></geometry>
        </collision>
      </link>
    </model>

    <!-- ================================================================
         HOME BASE CHARGING / SWAP STATION (at origin)
         Includes the landing pad model reference
    ================================================================ -->
    <include>
      <uri>model://charging_station</uri>
      <pose>0 0 0 0 0 0</pose>
      <name>charging_station</name>
    </include>

    <include>
      <uri>model://landing_pad</uri>
      <pose>0 0 0.01 0 0 0</pose>
      <name>home_landing_pad</name>
    </include>

    <!-- ================================================================
         DELIVERY TARGET PADS
    ================================================================ -->
    <!-- Hospital delivery pad -->
    <include>
      <uri>model://landing_pad</uri>
      <pose>5 90 0.01 0 0 0</pose>
      <name>delivery_pad_hospital</name>
    </include>

    <!-- Secondary delivery pad (pharmacy area) -->
    <include>
      <uri>model://landing_pad</uri>
      <pose>60 20 0.01 0 0 0</pose>
      <name>delivery_pad_pharmacy</name>
    </include>

    <!-- ================================================================
         SPAWN POSE for the drone (above home landing pad)
         The drone_spawner launch file uses this reference point.
    ================================================================ -->
    <!-- Drone is spawned in the launch file at 0 0 0.3 -->

  </world>
</sdf>
